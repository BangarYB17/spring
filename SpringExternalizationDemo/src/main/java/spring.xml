<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	 <bean class="org.springframework.context.support.PropertySourcesPlaceholderConfigurer">
	       <property name="location" value="com/yogesh/externalization/SpringExternalizationDemo/database.properties"></property>
	 </bean>
	 
	 <bean name="mydao" class="com.yogesh.externalization.SpringExternalizationDemo.MyDao">
	    <constructor-arg>
	       <value>${dbSource}</value>
	    </constructor-arg>
	 </bean>
</beans>